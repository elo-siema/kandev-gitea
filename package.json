{
  "name": "kandev-plugin-gitea",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build:ui": "npm run typecheck && esbuild ui/src/bundle.ts --bundle --format=esm --target=es2022 --outfile=ui/bundle.js",
    "typecheck": "tsc --project ui/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@kdlbs/plugin-sdk": "0.3.0",
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
